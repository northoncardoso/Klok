import SQLite from 'react-native-sqlite-storage';

const db = SQLite.openDatabase(
    {
        name: 'funcionarios.db',
        location: 'default',
    },
    () => console.log('Banco aberto'),
    (error) => console.log('Erro ao abrir DB', error)
);

export function criarTabela() {
    db.transaction(tx => {
        tx.executeSql(
            `CREATE TABLE IF NOT EXISTS funcionarios (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nome TEXT,
                numero TEXT,
                email TEXT
            )`,
            [],
            () => console.log("Tabela criada ou já existente"),
            (tx, error) => console.error("Erro ao criar tabela:", error)
        );
    });
}

export function carregarFuncionarios(setLista) {
    db.transaction(tx => {
        tx.executeSql(
            "SELECT * FROM funcionarios",
            [],
            (tx, resultados) => {
                const lista = [];
                for (let i = 0; i < resultados.rows.length; i++) {
                    lista.push(resultados.rows.item(i)); 
                }
                setLista(lista);
            }
        );
    });
}

export function inserirFuncionario(nome, numero, email, callback) {
    db.transaction(tx => {
        tx.executeSql(
            "INSERT INTO funcionarios (nome, numero, email) VALUES (?,?,?)",
            [nome, numero, email],
            (tx, resultado) => {
                callback({
                    id: resultado.insertId,
                    nome,
                    numero,
                    email
                });
            },
            (tx, error) => {
                console.error("Erro ao inserir funcionario:", error);
            }
        );
    });
}
export function deletarFuncionario(id, callback) {
    db.transaction(tx => {
        tx.executeSql(
            "DELETE FROM funcionarios WHERE id = ?",
            [id],
            () => {
                callback();
            }
        );
    });
}
