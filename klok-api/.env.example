PORT=3000
# Deixe vazio em desenvolvimento. Com "production" o link de recuperacao
# de senha deixa de ser devolvido na resposta da API (que viraria um oraculo
# de tomada de conta) e o boot avisa se faltar SMTP.
NODE_ENV=
JWT_SECRET=troque-este-segredo-antes-de-producao
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=818387140252-0drv1qdg8pjpqnts804604iv1alh56bk.apps.googleusercontent.com
# Base publica usada no link de recuperacao enviado por email (dev: IP do PC na rede. Prod: dominio https da API).
URL_BASE=http://127.0.0.1:3000
# SMTP para enviar o link de "esqueci minha senha". Sem SMTP, o link é exibido no terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_REMETENTE=
